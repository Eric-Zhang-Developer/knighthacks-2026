#!/bin/sh
# Pre-commit: the same checks CI runs, for humans too. Enabled with `git config core.hooksPath .agents/hooks`.
# `git commit --no-verify` skips it in an emergency; CI still runs the same checks on the PR.
export PYTHONDONTWRITEBYTECODE=1  # no __pycache__ in .agents/scripts to commit by accident
root=$(git rev-parse --show-toplevel) || exit 1
py=""
for c in python3.14 python3.13 python3.12 python3.11 python3; do
  command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null && py=$c && break
done
if [ -z "$py" ]; then
  echo "pre-commit: skipped, needs Python 3.11+ (macOS: brew install python). CI still runs these checks."
  exit 0
fi
"$py" "$root/.agents/scripts/check_markers.py" --root "$root" --staged || exit 1
"$py" "$root/.agents/scripts/check_ownership.py" --root "$root" --lint-specs >/dev/null || {
  "$py" "$root/.agents/scripts/check_ownership.py" --root "$root" --lint-specs
  exit 1
}
