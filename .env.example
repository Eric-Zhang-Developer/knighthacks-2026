# Copy to .env.local (never committed). Server-only: none of these may be prefixed NEXT_PUBLIC_.
DATABASE_URL=            # Neon connection string; use the dev or test branch locally
TEST_DATABASE_URL=       # Neon `test` branch; export it as DATABASE_URL for real-database verification, never production
GEMINI_API_KEY=
GEMINI_MODEL=            # pinned Gemini model ID
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=         # pinned Claude model ID; Claude is preferred when this and the key are set
ANTHROPIC_WORKSPACE_ID=  # only for a key not scoped to a workspace (the API rejects those without it)
AI_PROVIDER=             # set to gemini to prefer Gemini; the other configured provider is the fallback
HF_TOKEN=                # Hugging Face token for the Inference API
EMBED_MODEL=BAAI/bge-m3
ELEVENLABS_API_KEY=
